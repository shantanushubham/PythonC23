# Base URL of the Django backend (no trailing slash, no /api suffix).
#
#  iOS simulator:      http://localhost:8000
#  Android emulator:   http://localhost:8000   (run `adb reverse tcp:8000 tcp:8000` first)
#  Physical device:    http://<your-computer-LAN-IP>:8000
#                      (also add that IP to ALLOWED_HOSTS in Django and run
#                       `python manage.py runserver 0.0.0.0:8000`)
EXPO_PUBLIC_API_URL=http://localhost:8000
