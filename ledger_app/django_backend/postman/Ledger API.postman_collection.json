{
  "info": {
    "name": "Ledger API",
    "description": "Django REST API for the ledger app.\n\nSelect the Ledger Local environment, then run Auth / Signup (or Login). Later requests send Authorization: Bearer {{access_token}}.\n\nBase URL defaults to http://127.0.0.1:8000. Postgres from docker-compose.yml must be running and migrations applied before these calls succeed.\n\nList endpoints use page-number pagination with a page size of 20.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
