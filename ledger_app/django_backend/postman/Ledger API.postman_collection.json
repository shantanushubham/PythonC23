  "item": [
    {
      "name": "Auth",
      "description": "Public except logout and change-password. Signup or login stores access_token, refresh_token, and user_id. Access tokens last 15 minutes. Refresh rotates the refresh token and blacklists the previous one. Logout blacklists the current refresh token.",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/signup/",
            "description": "Register a user. Email is stored as the username (lowercased). A wallet with balance 0.00 is created in the same transaction. Returns the user plus access and refresh tokens.\n\n400 if the email is taken or the password fails Django's validators (min length 8, not entirely numeric, not a common password, not too similar to the email) or confirm_password does not match.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"first_name\": \"{{first_name}}\",\n  \"last_name\": \"{{last_name}}\",\n  \"password\": \"{{password}}\",\n  \"confirm_password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function save(key, value) {",
                  "    if (value === undefined || value === null || value === '') return;",
                  "    const text = String(value);",
                  "    pm.collectionVariables.set(key, text);",
                  "    if (pm.environment && pm.environment.name) pm.environment.set(key, text);",
                  "}",
                  "",
                  "pm.test('Status is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "save('access_token', body.access);",
                  "save('refresh_token', body.refresh);",
                  "if (body.user) save('user_id', body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login/",
            "description": "Email and password. Email match is case-insensitive. Returns the same shape as signup. 400 with non_field_errors when the credentials are wrong or the user is inactive.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function save(key, value) {",
                  "    if (value === undefined || value === null || value === '') return;",
                  "    const text = String(value);",
                  "    pm.collectionVariables.set(key, text);",
                  "    if (pm.environment && pm.environment.name) pm.environment.set(key, text);",
                  "}",
                  "",
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "save('access_token', body.access);",
                  "save('refresh_token', body.refresh);",
                  "if (body.user) save('user_id', body.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/refresh/",
            "description": "Public. Send the current refresh token. The response includes a new access token and, because rotation is on, a new refresh token. The previous refresh token is blacklisted. 401 if the refresh token is missing, expired, or already blacklisted.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function save(key, value) {",
                  "    if (value === undefined || value === null || value === '') return;",
                  "    const text = String(value);",
                  "    pm.collectionVariables.set(key, text);",
                  "    if (pm.environment && pm.environment.name) pm.environment.set(key, text);",
                  "}",
                  "",
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "save('access_token', body.access);",
                  "save('refresh_token', body.refresh);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/logout/",
            "description": "Requires the access token. Blacklists the refresh token in the body and returns 205 with an empty body. A blacklisted refresh token cannot be used again. 400 if that refresh token is already invalid.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function save(key, value) {",
                  "    if (value === undefined || value === null || value === '') return;",
                  "    const text = String(value);",
                  "    pm.collectionVariables.set(key, text);",
                  "    if (pm.environment && pm.environment.name) pm.environment.set(key, text);",
                  "}",
                  "",
                  "pm.test('Status is 205', function () {",
                  "    pm.response.to.have.status(205);",
                  "});",
                  "",
                  "save('access_token', '');",
                  "save('refresh_token', '');"
                ]
              }
            }
          ]
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/change-password/",
            "description": "Requires the access token. Checks old_password against the current user, then runs the same password validators on new_password. On success the stored password variable is updated to new_password so the next Login uses it. Existing access tokens stay valid until they expire.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"{{password}}\",\n  \"new_password\": \"{{new_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function save(key, value) {",
                  "    if (value === undefined || value === null || value === '') return;",
                  "    const text = String(value);",
                  "    pm.collectionVariables.set(key, text);",
                  "    if (pm.environment && pm.environment.name) pm.environment.set(key, text);",
                  "}",
                  "",
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const next = pm.variables.get('new_password');",
                  "save('password', next);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "description": "All routes require a Bearer access token. A non-staff caller only sees and edits their own user; another user's id returns 404. Staff see every user. POST /api/users/ is disabled (405); create accounts with Auth / Signup. DELETE sets is_active to false and returns 204. The row is kept. An inactive user cannot log in.",
