              "raw": "{\n  \"account_holder_name\": \"{{account_holder_name}}\",\n  \"bank_name\": \"{{bank_name}}\",\n  \"account_number\": \"{{account_number}}\",\n  \"ifsc_code\": \"{{ifsc_code}}\",\n  \"account_type\": \"{{account_type}}\"\n}",
